# === RAIDO Hub + Station Config ===

# === Server ===
HUB_PORT=3000
TIME_SCALE=60
MAX_INPUT_CHARS=500
ADMIN_TOKEN=change-me-to-a-strong-random-token

# === DJ LLM (Persoenlichkeit, Track-Wahl, Moderation) ===
LLM_DJ_BASE_URL=https://api.groq.com/openai/v1
LLM_DJ_MODEL=llama-3.3-70b-versatile
LLM_DJ_API_KEY=gsk_...

# === Filter LLM (Sanitizer, Persona-Generator — billig/schnell reicht) ===
LLM_FILTER_BASE_URL=https://api.groq.com/openai/v1
LLM_FILTER_MODEL=llama-3.1-8b-instant
LLM_FILTER_API_KEY=gsk_...

